Panels:
  - Class: rviz_default_plugins/Displays
    Name: Displays
  - Class: rviz_default_plugins/Selection
    Name: Selection
  - Class: rviz_default_plugins/ToolProperties
    Name: Tool Properties
  - Class: rviz_default_plugins/Views
    Name: Views
  - Class: rviz_default_plugins/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: base_link

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ""
      Links:
        All Links Enabled: true
        base_link: { Show Axes: false, Show Trail: false, Alpha: 1, Value: true }
        link1:     { Show Axes: false, Show Trail: false, Alpha: 1, Value: true }
        link2:     { Show Axes: false, Show Trail: false, Alpha: 1, Value: true }
        link3:     { Show Axes: false, Show Trail: false, Alpha: 1, Value: true }
        link4:     { Show Axes: false, Show Trail: false, Alpha: 1, Value: true }
        link5:     { Show Axes: false, Show Trail: false, Alpha: 1, Value: true }

    - Class: rviz_default_plugins/Image
      Name: Camera Feed
      Enabled: true
      Image Topic: /camera/image_raw
      Normalize Range: true
      Queue Size: 1
      Transport Hint: raw

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0

  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
      Theta std deviation: 0.2617993950843811
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz_default_plugins/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz_default_plugins/PublishPoint
      Topic: /clicked_point
      Single click: true

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: base_link
      Distance: 0.865
      Focal Point:
        X: 0.05
        Y: 0.03
        Z: 0.20
      Pitch: 0.44
      Yaw: 0.91
      Near Clip Distance: 0.01
      Focal Shape Size: 0.05
      Focal Shape Fixed Size: true
      Invert Z Axis: false
      Enable Stereo Rendering:
        Value: false
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false

Window Geometry:
  Width: 1331
  Height: 958
  X: 311
  Y: 27
  Hide Left Dock: false
  Hide Right Dock: false
  Displays:
    collapsed: false
  Selection:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Time:
    collapsed: false
